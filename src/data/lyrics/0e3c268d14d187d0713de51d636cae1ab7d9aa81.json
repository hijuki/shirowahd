{"hasil":{"baris":[{"time":22.76,"text":"Humingang malalim, pumikit na muna"},{"time":31.76,"text":"At baka sakaling namamalikmata lang"},{"time":40.85,"text":"Ba't nababahala? 'Di ba't ako'y mag-isa?"},{"time":50.27,"text":"Kala ko'y payapa, boses mo'y tumatawag pa"},{"time":59.82,"text":"Binaon naman na ang lahat"},{"time":64.39,"text":"Tinakpan naman na 'king sugat"},{"time":68.84,"text":"Ngunit ba't ba andito pa rin?"},{"time":74.06,"text":"Hirap na 'kong intindihin"},{"time":78.05,"text":"Tanging panalangin, lubayan na sana"},{"time":86.88,"text":"Dahil sa bawat tingin, mukha mo'y nakikita"},{"time":96.43,"text":"Kahit sa'n man mapunta ay anino mo'y kumakapit sa 'king kamay"},{"time":105.63,"text":"Ako ay dahan-dahang nililibing ng buhay pa"},{"time":114.84,"text":"Hindi na makalaya"},{"time":119.4,"text":"Dinadalaw mo 'ko bawat gabi"},{"time":124.09,"text":"Wala mang nakikita"},{"time":128.68,"text":"Haplos mo'y ramdam pa rin sa dilim"},{"time":133.13,"text":"Hindi na nananaginip"},{"time":137.84,"text":"Hindi na ma- makagising"},{"time":142.53,"text":"Pasindi na ng ilaw"},{"time":146.92,"text":"Minumulto na 'ko ng damdamin ko (ng damdamin ko)"},{"time":153.3,"text":"'Di mo ba ako lilisanin?"},{"time":157.21,"text":"Hindi pa ba sapat pagpapahirap sa 'kin? (damdamin ko)"},{"time":161.83,"text":"Hindi na ba ma- mamamayapa?"},{"time":166.77,"text":"Hindi na ba ma- mamamayapa?"},{"time":170.35,"text":"Hindi na makalaya"},{"time":174.93,"text":"Dinadalaw mo 'ko bawat gabi"},{"time":179.32,"text":"Wala mang nakikita"},{"time":183.99,"text":"Haplos mo'y ramdam pa rin sa dilim"},{"time":188.7,"text":"Hindi na nananaginip"},{"time":193.11,"text":"Hindi na ma- makagising"},{"time":197.63,"text":"Pasindi na ng ilaw"},{"time":202.47,"text":"Minumulto na 'ko ng damdamin ko (ng damdamin ko)"},{"time":208.37,"text":"(Makalaya) hindi mo ba ako lilisanin?"},{"time":212.1,"text":"(Dinadalaw mo 'ko bawat gabi)"},{"time":213.32,"text":"Hindi pa ba sapat pagpapahirap sa 'kin? (Wala mang nakikita)"},{"time":217.89,"text":"Hindi na ba ma- mamamayapa? (Haplos mo'y ramdam pa rin sa dilim)"},{"time":222.28,"text":"Hindi na ba ma- mamamayapa?"},{"time":227.37,"text":""}],"artis":"Cup of Joe","judul":"Multo","durasi":238,"selisih":0,"sumber":"search-balik"}}