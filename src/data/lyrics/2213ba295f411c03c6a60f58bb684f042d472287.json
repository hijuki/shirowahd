{"hasil":{"baris":[{"time":13.52,"text":"Tahun lalu, berjuta alasanku"},{"time":19.51,"text":"Maaf tak bisa pulang, penghasilanku pas-pasan"},{"time":25.55,"text":"Kali ini sudah lumayan"},{"time":31.47,"text":"Berkat doamu, diijabah Sang Maha Kaya"},{"time":37.52,"text":"Dan tahun ini, ku bisa pulang"},{"time":43.53,"text":"Oleh-oleh sudah di tangan"},{"time":49.53,"text":"Tapi anehnya, bukan kau yang menyambutku"},{"time":55.01,"text":"Oh, ternyata, kau yang lebih dulu pulang"},{"time":64.57,"text":"Ku bertamu ke rumah barumu"},{"time":70.03,"text":"Tak ada kamu"},{"time":73.03,"text":"Hanya papan dan namamu"},{"time":76.03,"text":"Mana ocehan, wewangian khasmu?"},{"time":81.79,"text":"Jarak ini terlalu jauh"},{"time":84.75,"text":"Kalau rindu, aku tak mampu"},{"time":88.09,"text":"Soal ikhlas, ternyata aku masih amatir"},{"time":93.75,"text":"Gengsi menyelimutiku"},{"time":96.79,"text":"Manusia ini kehilanganmu"},{"time":121.07,"text":"Ho-oh-oh-oh"},{"time":127.78,"text":"Sesi potret yang s'lalu kubenci"},{"time":133.78,"text":"Aneh rasanya kau tak di sini"},{"time":139.5,"text":"Susunan barisannya tak sama lagi"},{"time":143.74,"text":"Oh-oh, satu, dua, tiga"},{"time":149.28,"text":"Ini nyata, kau telah pergi"},{"time":157.57,"text":"Ku bertamu ke rumah barumu"},{"time":162.96,"text":"Tak ada kamu"},{"time":165.71,"text":"Hanya papan dan namamu"},{"time":168.75,"text":"Mana ocehan, wewangian khasmu?"},{"time":174.52,"text":"Jarak ini terlalu jauh"},{"time":177.87,"text":"Kalau rindu, aku tak mampu"},{"time":181.11,"text":"Sesal hatiku tak sempat temani kamu"},{"time":186.36,"text":"Harusnya kubisikkan kata ajaib ke telingamu"},{"time":193.09,"text":"Soal ikhlas, ternyata aku masih amatir"},{"time":198.24,"text":"Masih sangat amatir"},{"time":204.5,"text":"Gengsi menyelimutiku"},{"time":207.66,"text":"Manusia ini kehilanganmu"},{"time":223.06,"text":"Kehilanganmu"},{"time":235.32,"text":""}],"artis":"eńau","judul":"Sesi Potret","durasi":306,"selisih":0,"sumber":"search-judul"}}