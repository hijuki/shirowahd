{"hasil":{"baris":[{"time":23.28,"text":"Suatu malam Adam bercerita"},{"time":33.54,"text":"Hawanya tak lagi di jalur yang sama"},{"time":43.89,"text":"Bacaan dan doa yang mulai berbeda"},{"time":54.02,"text":"Ego dan air mata kita bicara"},{"time":63.74,"text":"Gila"},{"time":67.49,"text":"Tak masuk logika"},{"time":72.35,"text":"Termangu hatiku"},{"time":77.06,"text":""},{"time":79.13,"text":"Kau menggenggam, ku menadahnya"},{"time":89.73,"text":"Berdamai dengan apa yang terjadi"},{"time":99.88,"text":"Kunci dari semua masalah ini"},{"time":110.15,"text":"Jujur, tak mudah untuk melangkah pergi"},{"time":120.55,"text":"Ini soal hati, bukan yang diyakini"},{"time":129.37,"text":"Oh, gila"},{"time":133.82,"text":"Tak masuk logika"},{"time":138.71,"text":"Termangu hatiku"},{"time":145.51,"text":"Kau menggenggam, ku menadahnya"},{"time":150.44,"text":"Oh, gila"},{"time":154.16,"text":"Ini tak biasa"},{"time":159.12,"text":"Tertegun hatiku"},{"time":165.82,"text":"Kau menggenggam, ku menadahnya"},{"time":175.83,"text":"Ho-oh-oh (ah-ah)"},{"time":179.51,"text":"Ho-oh-oh-oh, ho-oh-oh"},{"time":185.18,"text":""},{"time":190.27,"text":"Jangan salahkan, fahamku kini tertuju, oh-oh"},{"time":199.82,"text":"Siapa yang tahu, siapa yang mau"},{"time":205.43,"text":"Kau di sana, aku di seberangmu"},{"time":210.33,"text":"Cerita kita sulit dicerna"},{"time":215.38,"text":"Tak lagi sama cara berdoa"},{"time":220.55,"text":"Cerita kita sulit diterka"},{"time":225.79,"text":"Tak lagi sama arah kiblatnya"},{"time":230.24,"text":"Oh, cerita kita sulit dicerna"},{"time":235.79,"text":"Tak lagi sama cara berdoa"},{"time":240.47,"text":"Oh, cerita kita sulit diterka"},{"time":246.18,"text":"Tak lagi sama arah kiblatnya"},{"time":253.18,"text":""}],"artis":"Mangu, . Charita Utami ( Official Audio ), Fourtwnty Music","judul":"Fourtwnty","durasi":263,"selisih":4,"sumber":"search"}}