*.vid
web/.next/
# State runtime & file berisi kredensial — jangan ikut git.
# config.js TETAP di-track (sekarang isinya cuma process.env refs, bukan secret).
# Nilai asli semua key ada di .env (template: .env.example).
admin-settings.json
upload-log.json
backup-history.json
vids/
.pair-number

# Logo/aset brand hasil upload admin (data user, bukan kode)
brand-assets/

# Cache favicon hasil turunan logo admin (dibangun ulang otomatis saat dibutuhkan).
# Ditaruh di luar brand-assets/ supaya tidak muncul sebagai entri di galeri admin.
.icon-cache/

# Cadangan sementara hasil audit
*.bak-audit

# ── Sampah yang pernah ikut ter-commit; jangan sampai kembali ─────────────
# Biner cloudflared (38 MB) diunduh otomatis oleh main.js saat ENABLE_TUNNEL=1,
# jadi tidak perlu ada di repo.
cloudflared
# Cadangan settings hasil operasi manual.
admin-settings.json.bak.*
# Skrip uji/migrasi sekali pakai.
uji-*.mjs
recover-cf.mjs
rename-ourin.sh
# Catatan rilis lokal (juga ada di daftar kecuali auto-backup).
UPDATE.txt

# Salinan tersanitasi dibuat ulang tiap backup — tidak perlu ter-track,
# dan isinya masih memuat ownerWhatsapp + struktur setelan lengkap.
admin-settings.sanitized.json

# Skrip audit/uji lokal — tidak untuk repo publik.
# Ditaruh di luar tmp/ karena hillz-temp-cleaner.js menyapu tmp/ tiap 30 menit.
.audit/
