# SHIROWAHD - contoh .env
# Salin jadi .env lalu isi. .env TIDAK ikut git.
# Berkas ini TER-COMMIT, jadi NILAI di sini harus selalu kosong.
#
# Wajib minimal: tidak ada. Bot bisa jalan tanpa .env sama sekali,
# lalu nomor WA ditautkan dari panel admin (/admin > Bot > Pairing).

# ── 1. Panel admin ────────────────────────────────────────────────
# Kalau diisi, menang atas admin-settings.json. Kosongkan untuk
# memakai password yang diatur lewat panel.
ADMIN_PASSWORD=

# ── 2. Domain publik (untuk og:image & tautan) ────────────────────
DOMAIN=

# ── 3. Backup ke GitHub (tombol Backup di panel) ──────────────────
GIT_ADDRESS=
GIT_TOKEN=
BRANCH=main

# Tarik ulang kode dari GitHub setiap kali bot restart (git reset --hard).
# BIARKAN KOSONG/0. Kalau =1, semua edit di VPS yang belum di-push akan
# DITIMPA versi remote setiap restart — termasuk perbaikan yang baru ditulis.
# Nyalakan hanya kalau VPS ini memang cuma mengikuti remote (deploy otomatis).
GIT_AUTO_SYNC=0

# ── 4. Notifikasi Telegram (opsional) ─────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 5. Cloudflare tunnel (opsional, 0 = mati) ─────────────────────
ENABLE_TUNNEL=0
CF_ACCOUNT=
CF_EMAIL=
CF_KEY=
CF_TUNNEL_ID=

# ── 6. Bot ────────────────────────────────────────────────────────
# Watchdog reconnect kalau tidak ada pesan masuk (menit). 0 = mati.
WATCHDOG_MINUTES=180

# Nomor WA bot. KOSONGKAN — nomor ditautkan dari panel admin.
# Isi hanya kalau ingin memaksa nomor tertentu tanpa membuka panel;
# papan status panel dan berkas .pair-number tetap menang atas ini.
PAIRING_NUMBER=

# ── 7. API key plugin (semua opsional) ────────────────────────────
# Plugin yang butuh key ini akan bilang "API key belum diatur"
# kalau kosong, bot tetap jalan normal.
GEMINI_API_KEY=
APIKEY_LOLHUMAN=
APIKEY_NEOXR=
APIKEY_FGSI=
APIKEY_GOOGLE=
APIKEY_GROQ=
APIKEY_BETABOTZ=
APIKEY_COVENANT=
APIKEY_ONLYM=
APIKEY_OBSCURA=
APIKEY_FIREFLY=
APIKEY_CUKI=

# ── 8. Cookie scraper (opsional) ──────────────────────────────────
TERABOX_COOKIE=
IMGDROP_COOKIE=

# ── 9. Penyetel lanjutan (opsional, boleh dibiarkan kosong) ───────
# Ambang RSS pengawas memori dalam MB. Kalau kosong, diturunkan dari
# RAM mesin (55%, dijepit 512-3072 MB) — jadi VPS 1 GB dapat ambang
# yang benar-benar tercapai sebelum OOM killer kernel bertindak.
RSS_LIMIT_MB=

# Setel 1 untuk melihat sebab tiap plugin yang gagal dimuat saat boot.
DEBUG_PLUGINS=

# production atau development. Kosong = production.
NODE_ENV=
