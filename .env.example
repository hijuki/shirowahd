# === SHIROWAHD .env template ===
# Copy ke .env lalu isi. File .env TIDAK ikut git (lihat .gitignore).

# --- GitHub backup (tombol Backup di panel admin) ---
GIT_ADDRESS=https://github.com/hijuki/shirowahd
GIT_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
BRANCH=main

# --- Cloudflare tunnel (opsional; ENABLE_TUNNEL=0 untuk mematikan) ---
ENABLE_TUNNEL=0
CF_ACCOUNT=
CF_EMAIL=
CF_KEY=
CF_WORKER=
CF_TUNNEL_ID=
DOMAIN=swhdhlz.my.id

# --- Web uploader / panel admin ---
# Kalau diisi, nilai ini menang atas admin-settings.json.
ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bot WhatsApp ---
# Watchdog reconnect kalau tidak ada pesan masuk. 0 = matikan. Default 180 menit.
WATCHDOG_MINUTES=180

# --- API keys plugin (dulu hardcode di config.js) ---
GEMINI_API_KEY=
APIKEY_LOLHUMAN=
APIKEY_NEOXR=
APIKEY_FGSI=
APIKEY_GOOGLE=
APIKEY_GROQ=
APIKEY_BETABOTZ=
APIKEY_COVENANT=
APIKEY_ONLYM=
APIKEY_OBSCURA=
APIKEY_FIREFLY=
APIKEY_CUKI=
// backup ref-sync verified
